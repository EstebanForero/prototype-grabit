PORT=8787
GRABIT_DB=data/seguimiento.sqlite
AGGREGATOR_SECRET=cambiar-por-un-secreto-largo
MAIL_HOST=imap.gmail.com
MAIL_PORT=993
MAIL_SECURE=true
MAIL_USER=
MAIL_PASSWORD=
MAIL_MAILBOX=INBOX
MAILBOX_FILE=data/mailbox.json
# SMTP del mismo buzón, solo para `bun run enviar`. Vacío reutiliza la cuenta guardada.
# Gmail: smtp.gmail.com:587 y la contraseña de aplicación, no la clave normal.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TO=
# Consola de 17TRACK. La clave de la cuenta no reemplaza la llave de la API.
TRACK17_CONSOLE_URL=https://user.17track.net/es
TRACK17_EMAIL=
TRACK17_PASSWORD=
# 17token del panel de API. Vacío: el seguimiento de transportadoras sigue por el webhook.
TRACK17_TOKEN=
