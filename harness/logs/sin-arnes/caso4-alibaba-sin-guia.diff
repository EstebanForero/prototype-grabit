+/** Un aviso de "pending" no es guía. Tampoco lo es el número de pedido ni un token sin dígitos. */
+function readTracking(text: string, orderNumber: string): string | null {
+  const match = text.match(
+    /(?:tracking(?:\s+id|\s+number)?|gu[ií]a|c[oó]digo de seguimiento|rastreo)\s*[:#]?\s*([A-Za-z0-9-]{4,40})/i,
+  );
+  const value = match?.[1]?.trim() ?? "";
+  if (!value || value === orderNumber) return null;
+  if (/^(pending|pendiente|tba|tbd|n\/a|na|none|null|unknown|unavailable)$/i.test(value)) return null;
+  if (!/^[A-Za-z0-9-]{8,40}$/.test(value) || !/\d/.test(value)) return null;
+  if (/^\d{3}-\d{7}-\d{7}$/.test(value)) return null;
+  return value;
+}
+
+function readCarrier(text: string): string | null {
+  const match = text.match(/(?:carrier|transportadora|enviado con|shipped with)\s*[:#]?\s*([A-Za-z][A-Za-z0-9 .'-]{1,40})/i);
+  const value = match?.[1]?.trim().replace(/[\s.]+$/, "") ?? "";
+  if (!value || /^(pending|pendiente|tba|tbd|n\/a|na|none|null|unknown|unavailable)$/i.test(value)) return null;
+  return value;
+}
