@@ -18,12 +18,37 @@ function bodyOf(raw: string): string {
   return split.length > 1 ? split.slice(1).join("\n") : raw;
 }
 
+function headerValue(raw: string, name: string): string {
+  const head = raw.split(/\r?\n\r?\n/)[0] ?? "";
+  return head.match(new RegExp(`^${name}:\\s*(.+)$`, "im"))?.[1]?.trim() ?? "";
+}
+
+/** El remitente pesa más que una tienda nombrada solo en el cuerpo (pie o reenvío). */
+function selectStore(raw: string): { store: (typeof STORES)[number]; order: string } | { error: string } {
+  const from = headerValue(raw, "from");
+  const subject = headerValue(raw, "subject");
+  const hits = STORES.flatMap((item, index) => {
+    const inFrom = item.test.test(from);
+    const inSubject = item.test.test(subject);
+    if (!inFrom && !inSubject && !item.test.test(raw)) return [];
+    const rank = (inFrom ? 4 : 0) + (inSubject ? 2 : 0);
+    return [{ item, index, rank, order: raw.match(item.order)?.[1] }];
+  });
+  if (hits.length === 0) return { error: "El correo no pertenece a una tienda cubierta." };
+  const withOrder = hits
+    .filter((hit) => hit.order)
+    .sort((a, b) => b.rank - a.rank || a.index - b.index);
+  const chosen = withOrder[0];
+  if (chosen?.order) return { store: chosen.item, order: chosen.order };
+  hits.sort((a, b) => b.rank - a.rank || a.index - b.index);
+  return { error: `No se encontró el número de pedido de ${hits[0].item.store}.` };
+}
