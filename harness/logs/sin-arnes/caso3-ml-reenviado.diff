+  const { store, order } = selected;
   const tracking = text.match(
     /(?:tracking(?:\s+id|\s+number)?|gu[ií]a|c[oó]digo de seguimiento|rastreo)\s*[:#]?\s*([A-Z0-9-]{8,40})/i,
   );
@@ -31,7 +56,7 @@ export function parseDispatchEmail(raw: string): ParsedDispatch | { error: strin
