+/** Dominio del remitente. Una oferta en el cuerpo no cambia la tienda. */
+function senderHost(raw: string): string {
+  const head = raw.split(/\r?\n\r?\n/, 1)[0] ?? "";
+  const from = head.match(/^from:[ \t]*([^\r\n]*)/im)?.[1]?.trim() ?? "";
+  const address = (from.match(/<([^>]+)>/)?.[1] ?? from).trim();
+  const at = address.lastIndexOf("@");
+  return (at >= 0 ? address.slice(at + 1) : address).toLowerCase();
+}
+
+function detectStore(raw: string): (typeof STORES)[number] | undefined {
+  const host = senderHost(raw);
+  const bySender = host ? STORES.find((item) => item.test.test(host)) : undefined;
+  if (bySender) return bySender;
+  return STORES.find((item) => item.test.test(raw) && item.order.test(raw)) ?? STORES.find((item) => item.test.test(raw));
+}
+
 export function parseDispatchEmail(raw: string): ParsedDispatch | { error: string } {
   const text = bodyOf(raw);
-  const store = STORES.find((item) => item.test.test(raw));
+  const store = detectStore(raw);
   if (!store) return { error: "El correo no pertenece a una tienda cubierta." };
   const order = raw.match(store.order);
   if (!order?.[1]) return { error: `No se encontró el número de pedido de ${store.store}.` };
